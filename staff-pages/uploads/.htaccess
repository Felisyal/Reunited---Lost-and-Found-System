# Uploaded files must never be executed as code.
# Block any script file, even if one somehow gets saved here.
<FilesMatch "\.(php\d?|phtml|phar|pht|phps|cgi|pl|py|sh|shtml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
